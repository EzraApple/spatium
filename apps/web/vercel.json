{
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://spatium.dawn-king-4a90.workers.dev/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://spatium.dawn-king-4a90.workers.dev/:path*",
      "permanent": false
    }
  ]
}
